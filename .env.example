# Copy this file to .env and fill in your Dataverse environment's values.
# .env is git-ignored; this template is not.

# Microsoft Entra ID tenant GUID for the target Dataverse environment.
AZURE_TENANT_ID=

# Application (client) ID of the registered Entra ID app.
AZURE_CLIENT_ID=

# Client secret credential for the registered Entra ID application.
AZURE_CLIENT_SECRET=

# Root URL of the target Dataverse environment, e.g. https://org.crm.dynamics.com
DATAVERSE_URL=

# Optional. Root logging level for the structured logging matrix. Defaults to INFO.
LOG_LEVEL=INFO
